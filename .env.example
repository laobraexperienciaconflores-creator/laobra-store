# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SECRET_KEY=tu-service-role-key-aqui

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Panel MP Developers > Tus integraciones > Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxx-xxxxxx-xxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxx-xxxxxx-xxxxxx

# ─── URLs del sitio ───────────────────────────────────────────────────────────
# URL pública sin barra final (en Vercel es automática: https://tu-app.vercel.app)
NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# URL del webhook de Mercado Pago — debe ser HTTPS y pública
# Ejemplo: https://tu-app.vercel.app/api/mercadopago/webhook
MERCADOPAGO_WEBHOOK_URL=https://tu-app.vercel.app/api/mercadopago/webhook

# ─── Admin (puedes agregar múltiples correos separados por comas) ─────────────
ADMIN_EMAIL=mateo.carrera.valencia12@gmail.com,laobra.experienciaconflores@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=mateo.carrera.valencia12@gmail.com,laobra.experienciaconflores@gmail.com

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Número con código de país, sin + ni espacios (ej: Perú → 51988559304)
NEXT_PUBLIC_WHATSAPP_NUMBER=51988559304
